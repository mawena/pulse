# MawenaPulse — serveur WebSocket Laravel Reverb
# Installer : sudo cp deploy/systemd/pulse-reverb.service /etc/systemd/system/
#             sudo systemctl daemon-reload && sudo systemctl enable --now pulse-reverb

[Unit]
Description=MawenaPulse Reverb WebSocket server
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/Mawena/pulse
ExecStart=/usr/bin/php artisan reverb:start --host=127.0.0.1 --port=8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
